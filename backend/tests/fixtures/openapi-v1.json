{
  "components": {
    "schemas": {
      "FeedbackInput": {
        "properties": {
          "comment": {
            "default": "",
            "maxLength": 1000,
            "title": "Comment",
            "type": "string"
          },
          "helpful": {
            "title": "Helpful",
            "type": "boolean"
          }
        },
        "required": [
          "helpful"
        ],
        "title": "FeedbackInput",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "QueryInput": {
        "properties": {
          "as_of_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of Date"
          },
          "conversation_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          },
          "question": {
            "maxLength": 4000,
            "minLength": 3,
            "title": "Question",
            "type": "string"
          },
          "version_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 2,
            "title": "Version Ids",
            "type": "array"
          }
        },
        "required": [
          "question"
        ],
        "title": "QueryInput",
        "type": "object"
      },
      "ReviewInput": {
        "properties": {
          "approved": {
            "title": "Approved",
            "type": "boolean"
          },
          "effective_from": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Effective From"
          },
          "effective_to": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Effective To"
          },
          "evidence": {
            "maxLength": 4000,
            "minLength": 10,
            "title": "Evidence",
            "type": "string"
          }
        },
        "required": [
          "approved",
          "evidence"
        ],
        "title": "ReviewInput",
        "type": "object"
      },
      "RunInput": {
        "properties": {
          "source": {
            "pattern": "^(vanban|congbao|hf|local)$",
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "source"
        ],
        "title": "RunInput",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
