# Copy via scripts/init_env.py; generated local credentials stay in .env.
ENVIRONMENT=development
PUBLIC_ORIGIN=http://localhost:3000
POSTGRES_USER=legal_rag
POSTGRES_DB=legal_rag
POSTGRES_PASSWORD=
DATABASE_URL=
REDIS_PASSWORD=
REDIS_URL=
SESSION_SECRET=
EMBEDDING_API_KEY=
EMBEDDING_URL=http://embedding:8001
EMBEDDING_DOCUMENT_TIMEOUT_SECONDS=600
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback
ADMIN_GOOGLE_SUBJECTS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
JEV_AI_API_KEY=
JEV_AI_MODEL=jev-latest
JEV_AI_BASE_URL=https://jev-ai.pro/api
JEV_AI_INFERENCE_ENABLED=false
JEV_AI_MAX_CALLS_PER_QUERY=32
# Zero blocks inference benchmarks until an operator chooses an explicit call limit.
JEV_AI_MAX_CALLS_PER_BENCHMARK=0
HF_TOKEN=
HF_BUCKETS=trtrnguyen14104/vietnamese-legal-documents-bucket,trtrnguyen14104/UTS_VLC-bucket
HF_DOCUMENT_LIMIT=100
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_REVISION=main
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
VNCORENLP_DIR=/models/vncorenlp
DATA_DIR=/data
DAILY_QUOTA=30
HISTORY_RETENTION_DAYS=90
QUERY_TIMEOUT_SECONDS=240
ROUTING_CONFIDENCE=0.75
ROUTING_MARGIN=0.15
SUPPORT_THRESHOLD=0.85
RELEVANCE_THRESHOLD=0.55
SOURCE_MAX_BYTES=25000000
SOURCE_MAX_PAGES=100
SOURCE_DELAY_SECONDS=1
